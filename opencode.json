{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugin": ["@dietrichgebert/ponytail"],
  "mcp": {
    "lean-ctx": {
      "type": "local",
      "command": ["lean-ctx"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  }
}
