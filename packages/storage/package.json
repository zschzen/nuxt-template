{
  "name": "@template/storage",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": "./nuxt.config.ts",
    "./workers/*": "./app/workers/*",
    "./composables/*": "./app/composables/*"
  },
  "scripts": {
    "clean": "rm -rf .nuxt .playground/.nuxt .turbo",
    "postinstall": "nuxi prepare .playground",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:fix": "eslint . --fix --cache",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "fflate": "catalog:storage",
    "tinybase": "catalog:storage"
  },
  "devDependencies": {
    "@nuxt/eslint": "catalog:linting",
    "@nuxt/test-utils": "catalog:testing",
    "happy-dom": "catalog:testing",
    "nuxt": "catalog:core",
    "typescript": "catalog:types",
    "vitest": "catalog:testing",
    "vue": "catalog:core",
    "vue-tsc": "catalog:types"
  }
}
