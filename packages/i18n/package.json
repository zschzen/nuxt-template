{
  "name": "@template/i18n",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": "./nuxt.config.ts",
    "./locales": "./locales.ts"
  },
  "scripts": {
    "clean": "rm -rf .nuxt .playground/.nuxt .turbo",
    "postinstall": "nuxi prepare .playground",
    "lint": "eslint . && pnpm i18n:check",
    "i18n:check": "node ./check-locales.mjs ./i18n/locales",
    "lint:fix": "eslint . --fix --cache",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxtjs/i18n": "catalog:modules"
  },
  "devDependencies": {
    "@nuxt/eslint": "catalog:linting",
    "nuxt": "catalog:core",
    "typescript": "catalog:types",
    "vue": "catalog:core",
    "vue-tsc": "catalog:types"
  }
}
