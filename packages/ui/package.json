    "@nuxtjs/color-mode": "catalog:modules",
    "@unocss/nuxt": "catalog:styling",
    "@unocss/preset-icons": "catalog:styling",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "nuxt": "catalog:core",
    "reka-ui": "catalog:ui",
    "shadcn-nuxt": "catalog:ui",
    "tailwind-merge": "catalog:ui",
    "typescript": "catalog:core",
    "unocss": "catalog:styling",
    "unocss-preset-animations": "catalog:styling",
